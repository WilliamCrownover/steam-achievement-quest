{
	"name": "steam-achievement-quest",
	"version": "1.0.0",
	"description": "An app to help reach 100% achievements complete on your Steam games. Identifies easy and difficult achievements and tracks the user's progress.",
	"main": "index.js",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"server": "npm start --prefix backend",
		"client": "npm start --prefix frontend",
		"dev": "concurrently \"npm run server\" \"npm run client\"",
		"shutdown": "concurrently \"npx kill-port 5000\" \"npx kill-port 3000\"",
		"lint": "eslint . --ext .js,.jsx,.ts,.tsx",
		"lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/WilliamCrownover/steam-achievement-quest.git"
	},
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/WilliamCrownover/steam-achievement-quest/issues"
	},
	"homepage": "https://github.com/WilliamCrownover/steam-achievement-quest#readme",
	"devDependencies": {
		"@eslint/js": "^9.35.0",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"concurrently": "^7.6.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"prettier": "^3.6.2"
	},
	"dependencies": {
		"@types/jest": "^29.2.5",
		"@types/node": "^18.11.18",
		"@types/react": "^18.0.26",
		"@types/react-dom": "^18.0.10",
		"react-select": "^5.10.0",
		"typescript": "^4.9.4"
	}
}
